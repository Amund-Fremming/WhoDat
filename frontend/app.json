{
  "expo": {
    "name": "WhoDat",
    "slug": "WhoDat",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/Shared/assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/Shared/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amundfremming.whodat",
      "buildNumber": "1.0.1"
