    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2351b30a-f17b-47b7-b30d-19133556a9f7"
      }
    }
  }
}
